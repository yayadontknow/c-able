# -----------------------
# Unity Source (Your 'unity' folder)
# -----------------------
# Ignore Unity generated temporary files, but keep Assets/Packages/ProjectSettings
unity/**/[Ll]ibrary/
unity/**/[Tt]emp/
unity/**/[Oo]bj/
unity/**/[Bb]uild/
unity/**/[Bb]uilds/
unity/**/[Ll]ogs/
unity/**/[Mm]emoryCaptures/
unity/**/[Uu]ser[Ss]ettings/

# -----------------------
# Flutter Unity Widget Exports
# -----------------------
# These folders are generated by Unity when you export. 
# They are large and platform-specific. Usually, you should NOT commit them.
# You should re-export from Unity if you clone the repo on a new machine.

android/unityLibrary/
android/xrmanifest.androidlib/

ios/UnityLibrary/
ios/Data/

